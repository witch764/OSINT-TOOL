# Set these in Netlify > Project configuration > Environment variables.
# Codes are server-side credentials. Change them if they become public.
OWNER_ACCESS_CODE=
SLIT_ACCESS_CODE=
# Optional: use Brave Search before the default public web index.
BRAVE_SEARCH_API_KEY=
# Optional: existing VirusTotal reports. Intelligence also needs a paid subscription.
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_INTELLIGENCE_ENABLED=false

# Optional server-only fallback. Creator can also connect privately in Account settings.
INDICIA_API_KEY=

# Optional OathNet integration. Server only; never use a VITE_ prefix.
OATHNET_API_KEY=
# JSON mapping EXISTING WitchSearch usernames to authorized email addresses.
# Verify control/permission out of band before adding an address; no self-approval.
# Example: {"researcher":["owned@example.com"]}
OATHNET_APPROVED_EMAILS={}
# Enable only after confirming authorized access to the OathNet stealer search API.
OATHNET_INFOSTEALER_ENABLED=false

# Shared approved-email mapping for the unified OathNet/HIBP exposure page.
# Takes precedence over OATHNET_APPROVED_EMAILS, including an explicit {} to revoke.
EXPOSURE_APPROVED_EMAILS={}
# Have I Been Pwned email checks require an API subscription permitting email search.
HIBP_API_KEY=
# AbuseIPDB v2 check: API key from a registered AbuseIPDB account (free quota available).
ABUSEIPDB_API_KEY=
# Optional keys for existing public adapters. IPINFO_TOKEN selects the Lite country/ASN API.
IPINFO_TOKEN=
URLSCAN_API_KEY=
