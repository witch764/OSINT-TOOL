# Set these in Netlify > Project configuration > Environment variables.
# Codes are server-side credentials. Change them if they become public.
OWNER_ACCESS_CODE=
SLIT_ACCESS_CODE=
# Optional: use Brave Search before the default public web index.
BRAVE_SEARCH_API_KEY=
# Optional: existing VirusTotal reports. Intelligence also needs a paid subscription.
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_INTELLIGENCE_ENABLED=false
